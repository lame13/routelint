{
  "name": "routelint",
  "version": "0.1.0",
  "description": "Lint the routes, links, canonicals, sitemaps, and indexability signals your SSR site actually ships.",
  "type": "module",
  "bin": {
    "routelint": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "PUBLISHING.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run package:check",
    "dev": "tsx src/cli.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "package:check": "node scripts/package-check.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "technical-seo",
    "ssr",
    "nextjs",
    "nuxt",
    "astro",
    "crawler",
    "sitemap",
    "canonical",
    "hreflang",
    "link-checker",
    "sarif",
    "cli"
  ],
  "author": {
    "name": "Niko M.",
    "url": "https://nikom.work"
  },
  "homepage": "https://nikom.work",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lame13/routelint.git"
  },
  "bugs": {
    "url": "https://github.com/lame13/routelint/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "15.0.0",
    "htmlparser2": "12.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
