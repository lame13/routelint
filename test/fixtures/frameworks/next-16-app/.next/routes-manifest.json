{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/old-pricing",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/preview/:path*",
      "destination": "/:path*",
      "statusCode": 307
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/blog/[slug]",
      "regex": "^/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/blog/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/docs/[[...parts]]",
      "regex": "^/docs(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPparts": "nxtPparts"
      },
      "namedRegex": "^/docs(?:/(?<nxtPparts>.+?))?(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/account",
      "regex": "^/account(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/account(?:/)?$"
    },
    {
      "page": "/pricing",
      "regex": "^/pricing(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pricing(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-HMR-Refresh"
  },
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  }
}
